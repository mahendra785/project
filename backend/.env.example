# PUMS backend configuration. Copy to `.env` to override defaults.
# Every variable is prefixed PUMS_ and maps to a field on `app.core.config.Settings`.

# --- Application ---
PUMS_ENVIRONMENT=development
PUMS_LOG_LEVEL=INFO

# --- API ---
# JSON array. Must include the origin the frontend is served from.
PUMS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Storage ---
# "json" persists analyses to disk (survives restarts); "memory" is ephemeral.
PUMS_STORAGE_BACKEND=json
PUMS_MAX_UPLOAD_BYTES=26214400

# --- Inference ---
PUMS_DEFAULT_MODEL_ID=intensity-mixture-seg-v1
PUMS_INFERENCE_SIZE=256
PUMS_RANDOM_SEED=1337

# --- Uncertainty ---
PUMS_HIGH_UNCERTAINTY_THRESHOLD=0.55
PUMS_MIN_REGION_AREA=24
PUMS_MAX_REPORTED_REGIONS=12

# --- Calibration ---
PUMS_DEFAULT_TARGET_RISK=0.10
PUMS_ECE_BINS=15
# Half this number of phantoms is generated per calibration set.
PUMS_CALIBRATION_SET_SIZE=200

# --- Distribution shift ---
# Derived by scripts/calibrate_shift_thresholds.py; re-run after changing the
# reference profile.
PUMS_SHIFT_THRESHOLD_MILD=0.42
PUMS_SHIFT_THRESHOLD_MODERATE=0.50
PUMS_SHIFT_THRESHOLD_SEVERE=0.78

# --- Risk engine (weights must sum to 1.0) ---
PUMS_RISK_WEIGHT_UNCERTAINTY=0.40
PUMS_RISK_WEIGHT_CONFIDENCE=0.25
PUMS_RISK_WEIGHT_SHIFT=0.20
PUMS_RISK_WEIGHT_CALIBRATION=0.15
PUMS_RISK_THRESHOLD_LOW=0.25
PUMS_RISK_THRESHOLD_MODERATE=0.50
PUMS_RISK_THRESHOLD_HIGH=0.72
