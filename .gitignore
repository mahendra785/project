# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime analysis storage (regenerated by running the app)
backend/var/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Environment ---
.env
.env.local
.env*.local
!.env.example

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Misc ---
*.log
npm-debug.log*
coverage/

# Next.js scaffold docs regenerated by the toolchain; not part of PUMS
frontend/AGENTS.md
frontend/CLAUDE.md

# Local agent/editor settings (kept on disk, not part of the deliverable)
.claude/

# Downloaded datasets and extracted volumes — never vendored into the repo.
# Fetch with: python backend/scripts/download_dataset.py <id>
data/raw/
data/datasets/

# Trained model weights (regenerated by scripts/train_pixel_model.py)
backend/var/models/

# Office lock files
~$*

# --- Documents: the repository holds code only ---
# Paper, reports and slides are kept on disk, not in git.
paper/
report/
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.tex
*.bib

# Markdown documents, except READMEs and the notebook run guide
*.md
!README.md
!scripts/kaggle/HOW_TO_RUN.md

# docs/: everything except the result files the backend and frontend read at runtime
# (backend/app/api/routes/research.py, frontend/components/showcase/showcase-data.ts)
docs/**
!docs/**/
!docs/research/experiments.json
!docs/research/results/*.json
!docs/research/results/*.csv.gz
!docs/research/results/backbones/*.json
docs/research/results_v2/
docs/research/results_v2_kaggle/

# --- Reproduction of the journal article (Code availability statement) ---
# The paper build script with its LaTeX source, bibliography and figures, the pre-registration and the aggregated
# revision results are public so that readers can regenerate every number, table and figure (see REPRODUCING.md).
!REPRODUCING.md
!paper/
paper/*
!paper/journal/
paper/journal/*
!paper/journal/build.py
!paper/journal/manuscript.src.tex
!paper/journal/refs.bib
!paper/journal/figures/
paper/journal/figures/*
!paper/journal/figures/*.pdf
!docs/research/preregistration-mgcrc.md
!docs/research/results_v2/
docs/research/results_v2/*
!docs/research/results_v2/summary_all.json
!docs/research/results_v2/manifests/
!docs/research/results_v2/manifests/*.json
